flowchart TB
  A["<b>Администратор доступа</b><br/>[Person]"]:::person
  subgraph B["<span style='white-space:nowrap;padding-right:520px'>Система управления доступом [Software System]</span>"]
    W["<b>Веб-интерфейс</b><br/>[Container: React, TypeScript]<br/><br/>Экраны изменений, разницы прав, ошибок, цепочек, политик и журнала"]:::cont
    S["<b>API-сервер</b><br/>[Container: Go]<br/><br/>Импорт, политики, изменения, проверки, объяснение прав, применение, журнал. Токен GitLab хранится только здесь"]:::cont
    P[("<b>PostgreSQL</b><br/>[Container: реляционная БД]<br/><br/>Копия назначений, реестр версий политик, изменения, результаты проверок, журнал")]:::cont
    R[("<b>RDF-хранилище</b><br/>[Container: SPARQL 1.1, SHACL]<br/><br/>Онтология ODRL-RBAC, политики, граф назначений для анализа")]:::cont
  end
  G["<b>GitLab</b><br/>[External System]<br/><br/>Фактические участники и роли, вход пользователей"]:::ext
