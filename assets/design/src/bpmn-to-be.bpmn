<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_1">
<bpmn:participant id="Pool_1" name="Модельная организация" processRef="Process_1"/>
<bpmn:participant id="Pool_GitLab" name="GitLab"/>
<bpmn:messageFlow id="Msg_1" name="Участники и роли" sourceRef="Pool_GitLab" targetRef="C1"/>
<bpmn:messageFlow id="Msg_2" name="Текущие участники" sourceRef="Pool_GitLab" targetRef="C4"/>
<bpmn:messageFlow id="Msg_3" name="Изменение участников" sourceRef="C5" targetRef="Pool_GitLab"/>
</bpmn:collaboration>
<bpmn:process id="Process_1" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="L_mgr" name="Руководитель команды"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>R1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_adm" name="Администратор доступа"><bpmn:flowNodeRef>U1</bpmn:flowNodeRef><bpmn:flowNodeRef>U2</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_sys" name="Система управления доступом"><bpmn:flowNodeRef>C1</bpmn:flowNodeRef><bpmn:flowNodeRef>C2</bpmn:flowNodeRef><bpmn:flowNodeRef>C3</bpmn:flowNodeRef><bpmn:flowNodeRef>C4</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>C5</bpmn:flowNodeRef><bpmn:flowNodeRef>B1</bpmn:flowNodeRef><bpmn:flowNodeRef>C7</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef><bpmn:flowNodeRef>C6</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Нужен доступ или смена роли"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:manualTask id="R1" name="Описать запрос в чате или заявке"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="U1" name="Подготовить изменение (FR-03)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="C1" name="Обновить назначения затронутых контейнеров (FR-01)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="C2" name="Рассчитать разницу прав (FR-04)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="C3" name="Проверить назначения на ошибки типов 1–3 (FR-05)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="U2" name="Изучить разницу, ошибки и цепочки прав (FR-04–06)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G2" name="Решение"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E2" name="Изменение отменено"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="C4" name="Сверить назначения с GitLab перед применением"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G3" name="Состояние изменилось?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="C5" name="Применить операции через REST API (FR-07)"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"/></bpmn:serviceTask>
<bpmn:boundaryEvent id="B1" name="Отказ GitLab" attachedToRef="C5"><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:errorEventDefinition id="B1_err"/></bpmn:boundaryEvent>
<bpmn:serviceTask id="C7" name="Обновить копию, отметить невыполненное в журнале"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E3" name="Применено не полностью"><bpmn:incoming>Flow_17</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="C6" name="Обновить копию и журнал (FR-08, NFR-03)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Права изменены"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" name="" sourceRef="S" targetRef="R1"/>
<bpmn:sequenceFlow id="Flow_2" name="" sourceRef="R1" targetRef="U1"/>
<bpmn:sequenceFlow id="Flow_3" name="" sourceRef="U1" targetRef="C1"/>
<bpmn:sequenceFlow id="Flow_4" name="" sourceRef="C1" targetRef="C2"/>
<bpmn:sequenceFlow id="Flow_5" name="" sourceRef="C2" targetRef="C3"/>
<bpmn:sequenceFlow id="Flow_6" name="" sourceRef="C3" targetRef="U2"/>
<bpmn:sequenceFlow id="Flow_7" name="" sourceRef="U2" targetRef="G2"/>
<bpmn:sequenceFlow id="Flow_8" name="Исправить" sourceRef="G2" targetRef="U1"/>
<bpmn:sequenceFlow id="Flow_9" name="Отменить" sourceRef="G2" targetRef="E2"/>
<bpmn:sequenceFlow id="Flow_10" name="Подтвердить: новых блокирующих ошибок нет" sourceRef="G2" targetRef="C4"/>
<bpmn:sequenceFlow id="Flow_11" name="" sourceRef="C4" targetRef="G3"/>
<bpmn:sequenceFlow id="Flow_12" name="Нет" sourceRef="G3" targetRef="C5"/>
<bpmn:sequenceFlow id="Flow_13" name="Да, проверить заново" sourceRef="G3" targetRef="C1"/>
<bpmn:sequenceFlow id="Flow_14" name="" sourceRef="C5" targetRef="C6"/>
<bpmn:sequenceFlow id="Flow_15" name="" sourceRef="C6" targetRef="E1"/>
<bpmn:sequenceFlow id="Flow_16" name="" sourceRef="B1" targetRef="C7"/>
<bpmn:sequenceFlow id="Flow_17" name="" sourceRef="C7" targetRef="E3"/>
<bpmn:textAnnotation id="N0"><bpmn:text>Р1. Назначения и наследование считает система</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N1"><bpmn:text>Р3. Разница прав видна до применения</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N2"><bpmn:text>Р2. Проверки заданы правилами, а не памятью администратора</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N3"><bpmn:text>Р4. Основание и результат сохраняются в журнале</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_N0" sourceRef="C1" targetRef="N0"/>
<bpmn:association id="Assoc_N1" sourceRef="C2" targetRef="N1"/>
<bpmn:association id="Assoc_N2" sourceRef="C3" targetRef="N2"/>
<bpmn:association id="Assoc_N3" sourceRef="C6" targetRef="N3"/>
</bpmn:process>
