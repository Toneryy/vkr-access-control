<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_1">
<bpmn:participant id="Pool_1" name="Модельная организация" processRef="Process_1"/>
<bpmn:participant id="Pool_GitLab" name="GitLab"/>
<bpmn:messageFlow id="Msg_1" name="Списки участников" sourceRef="Pool_GitLab" targetRef="A1"/>
<bpmn:messageFlow id="Msg_2" name="Изменение участника" sourceRef="A5" targetRef="Pool_GitLab"/>
</bpmn:collaboration>
<bpmn:process id="Process_1" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="L_mgr" name="Руководитель команды"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>R1</bpmn:flowNodeRef><bpmn:flowNodeRef>R2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_adm" name="Администратор доступа"><bpmn:flowNodeRef>A1</bpmn:flowNodeRef><bpmn:flowNodeRef>A2</bpmn:flowNodeRef><bpmn:flowNodeRef>A3</bpmn:flowNodeRef><bpmn:flowNodeRef>A4</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>A5</bpmn:flowNodeRef><bpmn:flowNodeRef>A6</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Нужен доступ или смена роли"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:manualTask id="R1" name="Описать запрос в чате или заявке"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="A1" name="Открыть списки участников группы, подгрупп и проекта"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"/></bpmn:manualTask>
<bpmn:manualTask id="A2" name="Определить текущие и унаследованные роли"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="A3" name="Сравнить роли с таблицей прав в документации"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="A4" name="Проверить конфликты ролей и сроки по памяти"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="G1" name="Замечена проблема?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="R2" name="Уточнить запрос"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="A5" name="Изменить участника в интерфейсе GitLab"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
<bpmn:manualTask id="A6" name="Записать изменение в заявке"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:manualTask>
<bpmn:endEvent id="E" name="Права изменены, итог не проверен"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" name="" sourceRef="S" targetRef="R1"/>
<bpmn:sequenceFlow id="Flow_2" name="" sourceRef="R1" targetRef="A1"/>
<bpmn:sequenceFlow id="Flow_3" name="" sourceRef="A1" targetRef="A2"/>
<bpmn:sequenceFlow id="Flow_4" name="" sourceRef="A2" targetRef="A3"/>
<bpmn:sequenceFlow id="Flow_5" name="" sourceRef="A3" targetRef="A4"/>
<bpmn:sequenceFlow id="Flow_6" name="" sourceRef="A4" targetRef="G1"/>
<bpmn:sequenceFlow id="Flow_7" name="Да" sourceRef="G1" targetRef="R2"/>
<bpmn:sequenceFlow id="Flow_8" name="" sourceRef="R2" targetRef="A1"/>
<bpmn:sequenceFlow id="Flow_9" name="Нет" sourceRef="G1" targetRef="A5"/>
<bpmn:sequenceFlow id="Flow_10" name="" sourceRef="A5" targetRef="A6"/>
<bpmn:sequenceFlow id="Flow_11" name="" sourceRef="A6" targetRef="E"/>
<bpmn:textAnnotation id="N1"><bpmn:text>П1. Наследование по группам и подгруппам считается вручную</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N2"><bpmn:text>П2. Правила разделения обязанностей нигде не заданы</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N3"><bpmn:text>П3. Какие права появятся и пропадут, заранее не видно</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="N4"><bpmn:text>П4. Основание и результат проверки не сохраняются</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_N1" sourceRef="A2" targetRef="N1"/>
<bpmn:association id="Assoc_N2" sourceRef="A4" targetRef="N2"/>
<bpmn:association id="Assoc_N3" sourceRef="A5" targetRef="N3"/>
<bpmn:association id="Assoc_N4" sourceRef="A6" targetRef="N4"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
<bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="20" y="10" width="1620" height="430"/></bpmndi:BPMNShape>
