<bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="1542" y="222" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1515" y="262" width="90" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
